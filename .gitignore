# Installed dependencies
node_modules/

# 构建产物(dist/ 与 tsbuildinfo 都不入库;各包 outDir 保持在包内)
dist/
*.tsbuildinfo

# 工具临时目录
.oxlint-cache/
.vitest/

# 观测项产物(变异 / 扫描):每次重算的落盘快照,不入库
reports/

# Stryker 的沙箱与日志:变异体复制进沙箱后再插桩,不影响源码树
.stryker-tmp/
stryker.log

# 本地子代理模型配置
.pi/subagents-lite.json
# codegraph 索引(由源码重建)
.codegraph/

# 人工配置与凭证:绝不入库(handoff J;hld §CI 规定 CI 无凭证)
.env
.env.local
.env.*.local
!.env.example
# 模型开通的非密钥事实(端点/模型标识/上下文),归 hld models.yaml 前的暂存,填完即弃
.modelwar-providers.md
.modelwar-models.json

# 对局运行产物:体量随 tick 数线性增长,且可由冻结脚本 + 规则集重生成(hld §3.1)。
# 冻结脚本本身在 archive/ 下,必须入库,否则新克隆永远无法复算历史对局。
runs/**
!runs/.gitkeep
