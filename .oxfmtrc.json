{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "quoteProps": "as-needed",
  "bracketSpacing": true,
  "arrowParens": "always",
  "proseWrap": "preserve",
  "objectWrap": "preserve",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "bracketSameLine": false,
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".scratch/**",
    ".pi/**",
    "node_modules/**",
    "dist/**",
    "packages/engine/sandbox-runtime/runtime.iife.js"
  ]
}
