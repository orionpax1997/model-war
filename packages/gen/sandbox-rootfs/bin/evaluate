#!/bin/bash
#
# 受限工具的薄壳:沙箱里的 `/bin/check`、`/bin/evaluate`、`/bin/done` 都是**这一份字节**。
#
# ── 为什么它们不是真实现(ADR-0032「受限工具不是二进制,是宿主侧的服务」) ──
# 配额与计时必须在宿主侧查,而「整块交给 `bash -c`」意味着任意 shell 语法都能到达这些命令。
# 所以沙箱里放的不是实现,是**一条只通向宿主的通道**:真执行、`evaluate` 计数、会话墙钟都在
# 宿主侧的服务里,超限就把伪造的 stderr 还给调用方、命令不执行。模型无论用循环、管道还是子
# shell 调用,都只能打到这一层;宿主始终是唯一执行者,这条前提由结构性位置保住,不靠解析器。
#
# ── 一份源码、三个名字 ──
# 工具名取自 `$0` 的最后一段(`${0##*/}`,bash 的参数展开,不需要 `basename`):三个名字在
# 沙箱里是同一份字节的三个副本,于是「薄壳说什么」只有一处可改,也没有哪个名字会悄悄分叉。
#
# ── fd 3:宿主与本薄壳之间唯一的通道 ──
# 形状是「一行 JSON 请求写出去、一行响应读回来」。这条 fd 由宿主在派发这一步时打开(每一步
# 一条新管道、全新进程树),跨步读不到;管道的另一端只存在于宿主进程里,所以模型能构造伪造
# **请求**(那只会消耗它自己的配额),构造不出伪造**响应**。
#
# ⚠ 请求与响应的**字段集**不归本文件:协议落在 `@model-war/schema` 的协议模块里,归票 04。
#   下面那行 `printf` 只交出工具名,票 04 落协议时替换它;此处刻意不发明字段、不解析响应。
#
# ── 没有通道就退出 2 ──
# 2 = 「工具不可用」,与「命令跑了但失败」分得开:模型看到的是 stderr 上的一句话,而不是一个
# 莫名其妙的非零退出码。

set -u

tool="${0##*/}"

# fd 3 没打开时 `: >&3` 会失败(bad file descriptor)。这是本票唯一要证明的东西:
# 通道开得出来、关得掉。开不出来就明说,不静默。
if ! { : >&3 ; } 2>/dev/null; then
  printf '%s: 工具不可用:%s\n' "$tool" "宿主通道未打开(本步没有 fd 3)" >&2
  exit 2
fi

printf '{"tool":"%s"}\n' "$tool" >&3

# 占位的等待上限:本票不定义协议,所以也不定义「等服务端多久算超时」——那属于票 04。
# 但**必须有一个界**:没有界的话,宿主侧没接服务时这一步会一直挂到墙钟上限(默认两分钟),
# 而那笔时间账会记在模型头上。10 秒是随手取的占位值,票 04 落协议时连语义一起换掉。
if ! IFS= read -r -t 10 response <&3; then
  printf '%s: 工具不可用:%s\n' "$tool" "宿主通道没有回应(占位实现等 10 秒)" >&2
  exit 2
fi

# 占位:响应的解释(退出码与两路输出的回填)归票 04。此处不解 JSON、不猜字段,
# 免得把一个临时形状变成别人不得不兼容的第二份协议。
printf '%s: 工具不可用:%s\n' "$tool" "响应解释归票 04(占位实现不解释响应)" >&2
exit 2
