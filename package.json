{
  "name": "model-war",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "四人对称 RTS 对战平台:规则、引擎与复算工具链",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "generate": "tsc -b packages/schema && node packages/tools/src/generate/run-generate.ts && tsc -b",
    "test": "vitest run --project unit --project property",
    "test:props": "vitest run --project property",
    "test:gates": "vitest run --project gates",
    "test:slow": "vitest run --project slow",
    "verify:fast": "pnpm run check:quick && pnpm run test",
    "bench:build": "node packages/tools/src/benchmarks/build-benchmarks.ts",
    "setup:hooks": "git config core.hooksPath .githooks",
    "fmt": "oxfmt --check apps packages package.json tsconfig.base.json tsconfig.scripts.json tsconfig.json vitest.config.ts vitest.global-setup.ts pnpm-workspace.yaml .oxfmtrc.json .oxlintrc.json .dependency-cruiser.js",
    "lint": "oxlint apps packages",
    "lint:types": "tsc -b --pretty false && oxlint --type-aware apps packages",
    "coupling": "node packages/tools/src/toolchain-coupling.ts",
    "check:no-float": "node packages/tools/src/gate/run-no-float-gate.ts",
    "check:declared-deps": "node packages/tools/src/gate/run-declared-deps-gate.ts",
    "check:drift": "node packages/tools/src/generate/run-drift-gate.ts",
    "check:bench": "node packages/tools/src/benchmarks/run-benchmarks-gate.ts",
    "check:selfproof": "node --disable-warning=ExperimentalWarning packages/tools/src/selfproof/run-selfproof-gate.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check:quick": "pnpm run fmt && pnpm run lint && pnpm run coupling && pnpm run check:no-float",
    "check:types": "pnpm run check:quick && pnpm run lint:types",
    "check:deps": "tsc -b --pretty false && depcruise packages/*/dist apps/*/dist",
    "check": "pnpm run check:types && vitest run --project unit --project property && pnpm run check:deps && pnpm run check:declared-deps && pnpm run check:drift && pnpm run check:bench"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "dependency-cruiser": "^18.4.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "oxc-parser": "^0.152.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "quickjs-wasi": "3.6.2",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  }
}
